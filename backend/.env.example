# Server
PORT=3000
CORS_ORIGIN=http://localhost:5173

# AI provider — set AI_PROVIDER and matching API key / model
# Supported: groq | openai | anthropic | ollama | mistral
AI_PROVIDER=groq
AI_API_KEY=your_groq_api_key_here
AI_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# Optional — override API base URL (Ollama, custom proxies, etc.)
# AI_BASE_URL=http://localhost:11434/v1

# Examples for other providers (uncomment one block):
# AI_PROVIDER=openai
# AI_API_KEY=sk-...
# AI_MODEL=gpt-4o-mini

# AI_PROVIDER=anthropic
# AI_API_KEY=sk-ant-...
# AI_MODEL=claude-sonnet-4-20250514

# AI_PROVIDER=ollama
# AI_MODEL=llama3.2
# AI_BASE_URL=http://localhost:11434/v1

# Optional — Pexels stock photos (https://www.pexels.com/api/). Without this, Lorem Flickr tag URLs are used.
PEXELS_API_KEY=
